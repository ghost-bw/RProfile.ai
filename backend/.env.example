PORT=5000
MONGO_URI=mongodb://localhost:27017/resumepro
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer / Gmail Config
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id

# Pinecone Config
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=resumepro

# Groq API Key (required for LLM features)
GROQ_API_KEY=your-groq-api-key

# Judge0 Execution Settings
# Option A: Use RapidAPI hosted Judge0 CE (includes a free tier of 50 reqs/day)
RAPIDAPI_KEY=your-rapidapi-key

# Option B: Use a custom Judge0 instance (self-hosted with Docker or a public endpoint)
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=your-custom-auth-token-if-required

# Text-To-Speech (TTS) Settings
# Provide either ElevenLabs or OpenAI API keys to enable ultra-realistic AI voice models.
# If both keys are omitted, the application will fallback to the browser's premium local/online voice engine.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# OPENAI_API_KEY=
# OPENAI_VOICE=alloy

